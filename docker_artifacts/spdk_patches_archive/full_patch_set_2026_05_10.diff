@@ -1484,13 +1569,16 @@ submit_single_io(struct perf_task *task)
 
 	task->submit_tsc = spdk_get_ticks();
 
-	if ((g_rw_percentage == 100) ||
-	    (g_rw_percentage != 0 &&
