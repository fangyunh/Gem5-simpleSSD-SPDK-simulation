      related_power_pin : VDD;
      max_transition : 320;
      capacitance : 0.556012;
      rise_capacitance : 0.549928;
      rise_capacitance_range (0.447861, 0.549928);
      fall_capacitance : 0.556012;
      fall_capacitance_range (0.449169, 0.556012);
      input_voltage : default_VDD_VSS_input;
    }
    ff (IQN,IQNN) {
      clocked_on : "!CLK";
      next_state : "(!D * !SE) + (!D * !SI) + (SE * !SI)";
      power_down_function : "(!VDD) + (VSS)";
    }
  }
}
